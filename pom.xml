<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.x: Spring Framework 6.2, Jakarta EE 10, Hibernate 6.6, Jackson 2 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.atech.curso</groupId>
    <artifactId>desarrollo-spring-ejercicios</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Desarrollo de aplicaciones con Spring - Ejercicios</name>
    <description>Ejercicios prácticos del curso Desarrollo de aplicaciones con Spring (Atech Advanced Solutions)</description>

    <modules>
        <module>m1-core-aop</module>
        <module>m2-boot</module>
        <module>m3-persistencia</module>
        <module>m4-web-rest-jsp</module>
        <module>m5-amqp</module>
        <module>m6-integration</module>
        <module>m7-security-oauth2</module>
        <!-- Ejemplo extra, fuera del temario numerado -->
        <module>extra-xml-config</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.9</springdoc.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <image>
                            <name>atech/${project.artifactId}:${project.version}</name>
                        </image>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
